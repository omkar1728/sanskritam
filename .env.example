# Copy to .env. Defaults below match backend/app/config.py and docker-compose.yml.
DATABASE_URL=postgresql://sloka:sloka@localhost:5433/sloka
TEST_DATABASE_URL=postgresql://sloka:sloka@localhost:5433/sloka_test

# "s3" (MinIO / AWS / any S3 API) or "memory" (tests only)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sloka
S3_ACCESS_KEY=sloka
S3_SECRET_KEY=sloka-secret-1
S3_REGION=us-east-1
S3_PATH_STYLE=true

# --- AWS S3 ---
# S3_ENDPOINT=
# S3_BUCKET=my-real-bucket
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_REGION=ap-south-1
# S3_PATH_STYLE=false

# --- MinIO hosted on Dokploy ---
# S3_ENDPOINT=https://minio.example.com
# S3_BUCKET=sloka
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_REGION=us-east-1
# S3_PATH_STYLE=true

# SQLite mirror of the database (0 interval disables)
# BACKUP_SQLITE_PATH=backups/sloka_mirror.sqlite
# BACKUP_INTERVAL_S=60
# BACKUP_KEEP=5
