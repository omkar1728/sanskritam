      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-7",
        "spans_beyond_this_verse": false,
        "text": "An ordinary family kuTumba is an assemblage of the householder, his wife, two of his parents, two sons, two daughters-in-law, one daughter, and one guest, totalling to ten members."
      }
