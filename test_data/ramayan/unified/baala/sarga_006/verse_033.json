    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.6.26",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "तीन योजनके विस्तारवाली अयोध्यामें दो योजनकी भूमि तो ऐसी थी, जहाँ पहुँचकर किसीके लिये भी युद्ध करना असम्भव था, इसलिये वह पुरी 'अयोध्या' इस सत्य एवं सार्थक नामसे प्रकाशित होती थी; जिसमें रहते हुए राजा दशरथ इस जगत् का पालन करते थे॥ २५-२६॥"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.6.27",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "जैसे चन्द्रमा नक्षत्रलोकका शासन करते हैं, उसी प्रकार महातेजस्वी महाराज दशरथ अयोध्यापुरीका शासन करते थे। उन्होंने अपने समस्त शत्रुओंको नष्ट कर दिया था।। २७॥"
      }
    ],
