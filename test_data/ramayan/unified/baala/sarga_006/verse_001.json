    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.6.1",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "उस अयोध्यापुरी में रहकर राजा दशरथ प्रजावर्ग का पालन करते थे। वे वेदों के विद्वान् तथा सभी उपयोगी वस्तुओं का संग्रह करने वाले थे। दूरदर्शी और महान् तेजस्वी थे। नगर और जनपद की प्रजा उनसे बहुत प्रेम रखती थी।"
      }
    ],
