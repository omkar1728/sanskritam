    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-10",
        "spans_beyond_this_verse": false,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "In that city none is there without his earrings, headgear, or garlands, none is an enjoyer of lowly things, or misses his regular oil-baths, or with an un-creamed body with sandalwood paste or with other body cream, or with an un-perfumed physique. [1-6-10]"
      }
    ],
