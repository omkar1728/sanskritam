    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-10",
        "spans_beyond_this_verse": false,
        "text": "Earrings are the indicators of scholarship, and there are grades in their make and design, on par with the education one receives. The headgears present their social status, while other decorations are to exhibit their lavishness."
      }
    ],
    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.6.10",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "वहाँ कोई भी कुण्डल, मुकुट और पुष्पहारसे शून्य नहीं था। किसीके पास भोग-सामग्रीकी कमी नहीं थी। कोई भी ऐसा नहीं था, जो नहा-धोकर साफ-सुथरा न हो, जिसके अंगोंमें चन्दनका लेप न हुआ हो तथा जो सुगन्धसे वञ्चित हो॥ १०॥"
      }
    ],
