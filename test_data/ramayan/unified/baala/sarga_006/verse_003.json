  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-1, 1-6-2, 1-6-3, 1-6-4",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "He who is well-versed in Veda-s, who is a gatherer of all scholars, riches and forces as well, a foreseer and a great resplendent one, also one who is esteemed by urbanites and countrymen alike, one who is a top-speeded chariot-warrior among the emperors of Ikshwaku kings, one who has performed many Vedic rituals, a virtuous one, a great controller, a saint-like kingly sage, one who he is renowned in all the three worlds, a mighty one with all his enemies eradicated, nevertheless who has friends, one who conquered all his senses, one who is similar to Indra, or Kubera on earth with his wealth, accumulations and other possessions, he that king Dasharatha while dwelling in the city of Ayodhya protected the world, like Manu, the foremost protector of mankind. [1-6-3,4,5]"
      }
    ],
