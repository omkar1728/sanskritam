    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-25",
        "spans_beyond_this_verse": true,
        "text": "The bhadra is the elephant class for King's ride, called bhadragaja . It is a state elephant with high honors and for occasional or ceremonial use. mandra and mR^iga are classes of breed tamed and used in wars or for the ride of other nobility. These are the essential mammals used for other lifting and carrying works."
      }
    ],
    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.6.25",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "हिमालय पर्वत पर उत्पन्न भद्रजाति के, विन्ध्यपर्वत पर उत्पन्न हुए मन्द्रजाति के तथा सह्यपर्वत पर पैदा हुए मृग जाति के हाथी भी वहाँ मौजूद थे। भद्र, मन्द्र और मृग -इन तीनों के मेल से उत्पन्न हुए संकरजाति के, भद्र और मन्द्र-इन दो जातियों के मेल से पैदा हुए संकर जाति के, भद्र और मृग जातिके संयोगसे उत्पन्न संकरजाति के तथा मृग और मन्द्र-इन दो जातियोंके सम्मिश्रण से पैदा हुए पर्वताकार गजराज भी, जो सदा मदोन्मत्त रहते थे, उस पुरीमें भरे हुए थे।"
      }
    ],
