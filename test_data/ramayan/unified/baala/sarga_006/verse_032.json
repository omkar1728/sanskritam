  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-25",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "That city is always full with vigorous and mountain like elephants bred mainly from three classes viz., Bhadra, Mandra and Mriga. And inter-bred among these three main classes are Bhadra-Mandra, Mandra-Mriga, Bhadra-Mriga and the like. [1-6-25]"
      },
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-26",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "While residing in which city King Dasharatha ruled the world that city is further fortified up to two more yojana-s outside city, true to its name a yodhya , an un-assailable one. [1-6-26]"
      }
    ],
