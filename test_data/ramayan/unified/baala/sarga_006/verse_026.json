    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-6-22",
        "spans_beyond_this_verse": false,
        "text": "It is said that the horses born in the rivers nadii+ja are brought to the city Ayodhya. They are not water horses but horses born at the place where the historically prominent Seven Rivers of Indus Valley Rivers flow."
      }
