    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-39, 1-1-40",
        "spans_beyond_this_verse": true,
        "text": "The translation of ekaagraH as \"undisturbed\" is done according to the context of Rama's anticipation that there might be repeated visits from various people to Chitrakuta and entreaties from them for Rama to return to Ayodhya. Normally ekaagraH is translated as \"single-pointed attention\". Govindaraja explains ekaagraH with respect to following father's injunction or being alert to increased presence of RakShasaas."
      }
    ],
