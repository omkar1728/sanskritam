    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-97",
        "spans_beyond_this_verse": false,
        "text": "In raamaraajyam upaasitvaa... the word used is upaasana is not ruling by sceptre but it is 'reverentially serving the kingdom...' as one would regard or treat his personal god with reverence. Rama thus served his kingdom as a devotee of his subjects and this is the concept of raamaraajya. The brahma loka is not the abode of four-faced Brahma, but still higher abode, rather VaikunTha itself."
      }
    ],
