    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-10",
        "spans_beyond_this_verse": false,
        "text": "When his physique is extolled, suddenly a weapon is said, in saying that 'his is longbow...' this is called prakramabhangadoSa 'jump-cut in narration...' It is not so, his lengthy arms are said firstly and those arms can wield a great bow that can eliminate enemies, both physical and psychological ones like ariSaDvarga like desire, ire, avarice, conceit etc., as detailed in verse 4 above."
      }
    ],
