    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-57",
        "spans_beyond_this_verse": true,
        "text": "Next verse onwards the episodes in KiShkindha are introduced. Now Rama meets Hanuma, the Vaanara. vanena= in forests, charati= moves about, iti= thus; therefore vaanara = 'forest-ranger' is the declination of the term Vaanara. Traditionally Hanuma is worshipped as a god."
      }
    ],
    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.1.56",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "महाबाहु रामने उसे मारकर उसका भी दाह किया, अतः वह स्वर्गको चला गया। जाते समय उसने रामसे धर्मचारिणी शबरीका पता बतलाया"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.1.57",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "और कहा—'रघुनन्दन! आप धर्मपरायणा संन्यासिनी शबरीके आश्रमपर जाइये'। शत्रुहन्ता महान् तेजस्वी दशरथकुमार राम शबरीके यहाँ गये"
      }
