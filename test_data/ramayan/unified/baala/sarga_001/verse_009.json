    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-9",
        "spans_beyond_this_verse": false,
        "text": "The Absolute is an adept one in creating the Creation yat sarvaj~naH sarvavit. He is niitimaan one who maintains the rhythm of universe as said at eSa setuH vidharaNa eSaam lokanaamasambhedaaya... He is propitious because shriiH kaantisaMpadoH lakshmyaam... gleaming, glistering richness of prosperity emanates from him. The following stanzas describe the physical qualities an Emperor should have by birth, as per saamudrikashaastra, the physiognomic treatise of astrology."
      }
    ],
