    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-44, 1-1-45",
        "spans_beyond_this_verse": false,
        "text": "The word asura is as from asuun raati iti asura: asu = life; ra= taker; i.e., life takers - demons, while the word sura is nectar consuming one, the divine. In later chapters of this canto, accounts are given as how these were created and named."
      }
    ],
    "hindi_translation": [
