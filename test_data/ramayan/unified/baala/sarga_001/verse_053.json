    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-49",
        "spans_beyond_this_verse": false,
        "text": "Ravana is the supremo of demons and the main antagonist in this epic. His name is Dashagriiva, meaning that he has ten heads. This name 'Ravana' obtains from the root ru - shabde raavayati iti raavaNaH 'one who makes people cry by his violent actions...' and it also means vishravasaH apatyam pumaan raavaNaH, vishravaso vishravaNa-ravaNau 'the son of one named Vishravasa...' Govindaraja."
      }
    ],
