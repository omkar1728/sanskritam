  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-92",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"In the kingdom of Rama, there will be no fear for his subjects from wildfires, gale-storms or from diseases, and there will be no fear from hunger or thieves, nor the cattle will be drowned in floodwaters as well... [1-1-92, 93a]"
      },
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-93",
        "spans_beyond_this_verse": false,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"Cities and states as well will be replete with wealth and grains likewise. All his subjects will be highly glad always, like in Krita yuga... [1-1-93b, 94a]"
      }
    ],
