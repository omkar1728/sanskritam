  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-86",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"After obtaining a boon from the gods, Rama raised up monkeys from death. He then travelled to Ayodhya by Pushpaka aircraft surrounded by good hearted ones... [1-1-86]"
      },
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-87",
        "spans_beyond_this_verse": false,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"Rama, with true valour, on going to sage Bharadwaja's hermitage, sent Hanuma to the presence of Bharata... [1-1-87]"
      },
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-88",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"Then, having boarded Pushpaka aircraft again after leaving the hermitage of Bharadwaja, and narrating past history to Sugreeva and others about the events in the days of his exile in forests, while flying overhead of the very same places, Rama went to Nandigrama... [1-1-88]"
      }
    ],
