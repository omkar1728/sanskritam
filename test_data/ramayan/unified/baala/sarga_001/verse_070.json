  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-63, 1-1-64",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"But Sugreeva remained ever doubtful with respect to Raghava, about Raghava's prowess. Sugreeva showed Dundubhi's big and great mountain-like dead body to gain confidence in Raghava... [1-1-63b, 64]"
      },
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-65",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "Great armed and very powerful Rama after seeing the bones of Dundubhi smiled and by the big toe of his foot threw it wholly for ten yojana-s length. [1-1-65]"
      }
    ],
