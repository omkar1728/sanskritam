    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-7",
        "spans_beyond_this_verse": false,
        "text": "Narada came hither to impart the legend of Rama, as Brahma already imparted the same to him, and wanted him to impart these very attributes to Valmiki to compose Ramayana. It is a coincidence of interests Valmiki and those of Narada and Brahma."
      }
    ],
