  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-7",
        "spans_beyond_this_verse": false,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"Oh! Sage Valmiki, the merits which you have extolled are many, and unattainable. I, after having known from Brahma of such a man with all these merits, will speak on...Let it be heard.\" Thus Narada started to say. [1-1-7]"
      }
    ],
