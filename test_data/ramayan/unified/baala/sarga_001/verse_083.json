    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-1-76, 1-1-77",
        "spans_beyond_this_verse": true,
        "text": "This is in sundara kaanDa. Hanuma sees Ravana and others in the court, and as a show of his strength burns down Lanka except the place where Seetha is stationed, only to prove that the riches and wealth enjoyed at the cost others will burn down to ashes some day, besides Vibheeshana's place, for Vibheeshana is the adherer of Dharma. This episode is to relegate the false pride of Ravana, and as a symbolic suggestion that pomp and effluence without virtue are short lived."
      }
    ],
