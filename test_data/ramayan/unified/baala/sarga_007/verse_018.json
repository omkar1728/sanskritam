    "english_commentary": null,
    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.7.18",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "समस्त देशों और कालोंमें वे गुणवान् ही सिद्ध होते थे, गुणहीन नहीं। संधि और विग्रहके उपयोग और अवसरका उन्हें अच्छी तरह ज्ञान था। वे स्वभावसे ही सम्पत्तिशाली (दैवी सम्पत्तिसे युक्त) थे॥ १८ ॥"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.7.19",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "उनमें राजकीय मन्त्रणाको गुप्त रखनेकी पूर्ण शक्ति थी। वे सूक्ष्मविषयका विचार करनेमें कुशल थे। नीतिशास्त्रमें उनकी विशेष जानकारी थी तथा वे सदा ही प्रिय लगनेवाली बात बोलते थे॥ १९॥"
      }
    ],
