    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.7.21",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "वे गुप्तचरोंके द्वारा अपने और शत्रु-राज्यके वृत्तान्तोंपर दृष्टि रखते थे, प्रजाका धर्मपूर्वक पालन करते थे तथा प्रजापालन करते हुए अधर्मसे दूर ही रहते थे॥२१॥"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.7.22",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "उनकी तीनों लोकोंमें प्रसिद्धि थी। वे उदार और सत्यप्रतिज्ञ थे। पुरुषसिंह राजा दशरथ अयोध्यामें ही रहकर इस पृथ्वीका शासन करते थे॥ २२ ॥"
      }
    ],
