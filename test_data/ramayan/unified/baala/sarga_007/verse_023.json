    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.7.23",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "उन्हें कभी अपनेसे बड़ा अथवा अपने समान भी कोई शत्रु नहीं मिला। उनके मित्रोंकी संख्या बहुत थी। सभी सामन्त उनके चरणोंमें मस्तक झुकाते थे। उनके प्रतापसे राज्यके सारे कण्टक (शत्रु एवं चोर आदि) नष्ट हो गये थे। जैसे देवराज इन्द्र स्वर्गमें रहकर तीनों लोकोंका पालन करते हैं, उसी प्रकार राजा दशरथ अयोध्यामें रहकर सम्पूर्ण जगत् का शासन करते थे। २३॥"
      }
    ],
