      {
        "source": "valmikiramayan.net",
        "net_locator": "1-7-23",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "Emperor Dasharatha has not encountered either a superior or an equal in his kingship, and to him there are many friends, subdued are his provincial kings and eliminated is thorniness by his own valour. He thus ruled the world like Indra would in Heaven. [1-7-23]"
      }
    ],
