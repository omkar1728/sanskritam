    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.5.15",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "वहाँके महलोंका निर्माण नाना प्रकारके रत्नोंसे हुआ था। वे गगनचुम्बी प्रासाद पर्वतोंके समान जान पड़ते थे। उनसे उस पुरीकी बड़ी शोभा हो रही थी। बहुसंख्यक कूटागारों (गुप्तगृहों अथवा स्त्रियोंके क्रीड़ाभवनों) से परिपूर्ण वह नगरी इन्द्रकी अमरावतीके समान जान पड़ती थी॥ १५ ॥"
      }
    ],
