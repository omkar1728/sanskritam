    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.2.30",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "ब्रह्माजी उनकी मनःस्थितिको समझकर हँसने लगे और मुनिवर वाल्मीकिसे इस प्रकार बोले—’ब्रह्मन् ! तुम्हारे मुँहसे निकला हुआ यह छन्दोबद्ध वाक्य श्लोकरूप ही होगा। इस विषयमें तुम्हें कोई अन्यथा विचार नहीं करना चाहिये। मेरे संकल्प अथवा प्रेरणासे ही तुम्हारे मुँहसे ऐसी वाणी निकली है।"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.2.32",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "‘मुनिश्रेष्ठ! तुम श्रीरामके सम्पूर्ण चरित्रका वर्णन करो। परम बुद्धिमान् भगवान् श्रीराम संसारमें सबसे बड़े धर्मात्मा और धीर पुरुष हैं। तुमने नारदजीके मुँहसे जैसा सुना है, उसीके अनुसार उनके चरित्रका चित्रण करो।"
      }
    ],
