    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-2-23",
        "spans_beyond_this_verse": false,
        "text": "Comment; The deities do not usually arrive on their own, but reveal themselves after a great penance, or on raising hue and cry as is done by demon devotees. Here Brahma, one among the Trinity of Hindu mythology, arrives on his own, to execute a divine deed through Valmiki, i.e. authoring the epic, Ramayana."
      }
    ],
