  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-3-27",
        "spans_beyond_this_verse": true,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "Hanuma's climbing Mt. Mahendra to leap over the ocean, and on the advice of the Ocean, Mt. Mainaka's coming up from under waters to give rest to Hanuma, and Hanuma's seeing that mountain are depicted. [1-3-27]"
      },
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-3-28",
        "spans_beyond_this_verse": false,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "Hanuma's killing the demoness Surasa, and his seeing of Simhika, a rapacious creature of gigantic origin, which captures its prey by the shadow, and Hanuma's killing that Simhika, and his seeing the mountain of Lanka, called Mt. Trikuta, on which the state of Lanka is built, Valmiki described them all. [1-3-28]"
      }
    ],
