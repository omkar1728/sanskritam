    "english_commentary": null,
    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.3.27",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "समुद्रलङ्घनके लिये हनुमान् जी का महेन्द्र पर्वतपर चढ़ना, समुद्रको लाँघना, समुद्रके कहनेसे ऊपर उठे हुए मैनाकका दर्शन करना,"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.3.28",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "इनको राक्षसीका डाँटना, हनुमान्द्वारा छायाग्राहिणी सिंहिका का दर्शन एवं निधन, लङ्काके आधारभूत पर्वत त्रिकूट का दर्शन,"
      }
    ],
