    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-3-24",
        "spans_beyond_this_verse": false,
        "text": "Comment: This raatri usually means night. But it includes day also. When saying triraatra, dasharaatra, in conducting rituals it includes daytime also. On the whole it is total rainy season that is admirably narrated in KiShkindhaa Kanda."
      }
    ],
