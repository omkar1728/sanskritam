    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.4.13",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "जब कभी ऋषियों, ब्राह्मणों तथा साधुओंका समागम होता था, उस समय उनके बीचमें बैठकर वे दोनों तत्त्वज्ञ बालक एकाग्रचित्त हो रामायणका गान किया करते थे।"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.4.14",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "एक दिनकी बात है, बहुत-से शुद्ध अन्तःकरणवाले महर्षियोंकी मण्डली एकत्र हुई थी। उसमें महान् सौभाग्यशाली तथा समस्त शुभ लक्षणोंसे सुशोभित महामनस्वी कुश और लव भी उपस्थित थे।"
      }
    ],
