    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-4-35",
        "spans_beyond_this_verse": true,
        "text": "Here Rama tells that this legend is 'efficacious' for it is the legend of Seetha, and should it be Rama's alone, he will get the blemish of self-glorification, aatmaprashamsaa doSa , and brave heroes of legends cannot be subjected to such a blemish. And to listen to the legend of his dearest, who at present is not with him, gives a kind of consolation, and thus he is asking all of us to listen to siitaayaH caritam mahat ..."
      }
    ],
    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.4.35",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "उस समय श्रीरामने अपने भाइयोंका ध्यान आकृष्ट करते हुए कहा—’ये दोनों कुमार मुनि होकर भी राजोचित लक्षणोंसे सम्पन्न हैं। संगीतमें कुशल होनेके साथ ही महान् तपस्वी हैं। ये जिस चरित्रका-प्रबन्ध काव्यका गान करते हैं, वह शब्दार्थालङ्कार, उत्तम गुण एवं सुन्दर रीति आदिसे युक्त होनेके कारण अत्यन्त प्रभावशाली है। मेरे लिये भी अभ्युदयकारक है; ऐसा वृद्ध पुरुषोंका कथन है। अतः तुम सब लोग ध्यान देकर इसे सुनो’।"
      }
    ],
