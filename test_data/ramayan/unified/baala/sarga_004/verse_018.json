    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.4.17",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "वे रामायण-कथाके गायक कुमार कुश और लवकी, जो प्रशंसा के ही योग्य थे, इस प्रकार प्रशंसा करने लगे—’अहो! इन बालकों के गीत में कितना माधुर्य है। श्लोकों की मधुरता तो और भी अद्भुत है।"
      },
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.4.18",
        "spans_beyond_this_verse": true,
        "provenance": "unverified: site states no translator/author",
        "text": "‘यद्यपि इस काव्यमें वर्णित घटना बहुत दिनों पहले हो चुकी है तो भी इन दोनों बालकोंने इस सभामें प्रवेश करके एक साथ ऐसे सुन्दर भावसे स्वरसम्पन्न, रागयुक्त मधुरगान किया है कि वे पहलेकी घटनाएँ भी प्रत्यक्ष-सी दिखायी देने लगी हैं—मानो अभी-अभी आँखोंके सामने घटित हो रही हों’ ।"
      }
    ],
