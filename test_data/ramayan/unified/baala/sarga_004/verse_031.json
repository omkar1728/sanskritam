    "hindi_translation": [
      {
        "source": "valmikiramayan.in",
        "in_locator": "1.4.33",
        "spans_beyond_this_verse": false,
        "provenance": "unverified: site states no translator/author",
        "text": "आज्ञा पाकर वे दोनों भाई वीणाके लयके साथ अपने मनके अनुकूल तार (उच्च) एवं मधुर स्वरमें राग अलापते हुए रामायणकाव्यका गान करने लगे। उनका उच्चारण इतना स्पष्ट था कि सुनते ही अर्थका बोध हो जाता था। उनका गान सुनकर श्रोताओंके समस्त अंगोंमें हर्षजनित रोमाञ्च हो आया तथा उन सबके मन और आत्मामें आनन्दकी तरंगें उठने लगीं। उस जनसभामें होनेवाला वह गान सबकी श्रवणेन्द्रियोंको अत्यन्त सुखद प्रतीत होता था।"
      }
    ],
