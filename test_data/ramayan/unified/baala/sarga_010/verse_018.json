    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-10-17",
        "spans_beyond_this_verse": false,
        "text": "This portrays the exclusion of the sage's son from the rest of the world by his father. He worshipped the courtesans, as he would worship some super-natural deities by saying the above words, which will usually be used in ritual worship of Hindu deities. He being a fruitarian has offered the courtesans the tuber fruits like sweet potatoes etc., which are ridiculous to urbanites, that too to the pleasure-taking courtesans."
      }
    ],
