    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-10-30, 1-10-31",
        "spans_beyond_this_verse": true,
        "text": "The salutation in prostration on the ground is usually performed before Gods or Deities, in reverence. It is called saaSTaanga-praNaamam = sa aSTa anga praNaamam , i.e., saluting with eight body parts touching the ground, indicating his absolute surrender to the worshipped."
      }
    ],
