    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-10-14",
        "spans_beyond_this_verse": false,
        "text": "The birth-event associated with his name is that he is born with a horn on the crown of his head. Thus he is named as Rishyasringa, i.e., R^iSi= the Sage; sR^i~Nga= horn; a Sage with a horn, and this here he recalls his birth time event."
      }
    ],
