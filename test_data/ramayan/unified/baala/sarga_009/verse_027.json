  "meanings": {
    "english_translation": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-9-19",
        "spans_beyond_this_verse": false,
        "translator": "K. M. K. Murthy / Desiraju Hanumanta Rao",
        "text": "\"Sage Rishyasringa, son-in-law of Romapaada, King of Anga ad as well as to you, if invited to our kingdom he will bless you to beget sons, oh! King... so said Sage Sanatkumaara to other sages and all this is retold by me.\" [Thus the charioteer and the Minister Sumantra completed his narration in confidence to King Dasharatha.] [1-9-19]"
      }
    ],
    "english_word_by_word": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-9-19",
        "spans_beyond_this_verse": false,
        "note": "devanagari_machine_converted is our ITRANS->Devanagari conversion, unchecked",
        "words": [
          {
            "roman_itrans": "RiShyasringaH tu jaamaataa",
            "devanagari_machine_converted": "ऱिष्यस्रिन्गः तु जामाता",
            "english": "Rishyasringa, son-in-law(of Romapaada)"
          },
          {
            "roman_itrans": "putraan tava vidhaasyati",
            "devanagari_machine_converted": "पुत्रान् तव विधास्यति",
            "english": "bless with sons to you"
          },
          {
            "roman_itrans": "etaavat vyaahR^itam mayaa",
            "devanagari_machine_converted": "एतावत् व्याहृतम् मया",
            "english": "all this, retold, by me"
          },
          {
            "roman_itrans": "sanatkumaarakathitam",
            "devanagari_machine_converted": "सनत्कुमारकथितम्",
            "english": "as said by Sanatkumaara."
          }
        ]
      }
    ],
    "english_commentary": [
      {
        "source": "valmikiramayan.net",
        "net_locator": "1-9-19",
        "spans_beyond_this_verse": false,
        "text": "Sage Rishyasringa is also a son-in-law to King Dasharatha. Princess Shanta, in a distant relationship is a daughter to King Dasharatha in relation and the adopted daughter of Romapaada, the King of Anga. Thus Sumantra's saying son-in-law also means Dasharatha's son-in-law, besides Romapada's."
      }
    ],
    "hindi_translation": [
      {
